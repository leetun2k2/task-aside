{
  "name": "taskaside",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "taskaside": "./bin/taskaside.js"
  },
  "files": [
    "bin",
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run build && bun run check:deterministic",
    "check:deterministic": "bun run test:contracts && bun run test:db && bun run test:api && bun run test:runs && bun run test:events && bun run test:mcp && bun run test:projection && bun run test:services && bun run test:supervisor && bun run test:harness && bun run test:adapter && bun run test:safety && bun run test:engine && bun run test:startup && bun run test:pool && bun run test:ui && bun run test:workflow && bun run test:distribution",
    "build:ui": "vite build",
    "build:services": "bun build src/cmd/backend.ts --target bun --outfile dist/services/backend.js && bun build src/cmd/agent-adapter.ts --target bun --outfile dist/services/agent-adapter.js && bun build src/cmd/execution-engine.ts --target bun --outfile dist/services/execution-engine.js && bun build src/cmd/cli.ts --target bun --outfile dist/services/cli.js",
    "build": "vite build && bun run build:services",
    "test:contracts": "bun run src/contracts/contract-checks.ts",
    "test:services": "bun run src/supervisor/service-checks.ts",
    "test:supervisor": "bun run src/supervisor/supervisor-harden-checks.ts",
    "test:harness": "bun run src/harness/harness-checks.ts",
    "test:db": "bun run src/backend/db-checks.ts",
    "test:api": "bun run src/backend/api-checks.ts",
    "test:runs": "bun run src/backend/run-checks.ts",
    "test:events": "bun run src/backend/event-checks.ts",
    "test:mcp": "bun run src/backend/mcp-checks.ts",
    "test:projection": "bun run src/backend/projection-checks.ts",
    "test:adapter": "bun run src/agent-adapter/adapter-checks.ts",
    "test:codex": "bun run src/agent-adapter/codex-checks.ts",
    "test:claude": "bun run src/agent-adapter/claude-checks.ts",
    "test:safety": "bun run src/agent-adapter/safety-checks.ts",
    "test:engine": "bun run src/execution-engine/engine-checks.ts",
    "test:startup": "bun run src/execution-engine/startup-checks.ts",
    "test:pool": "bun run src/execution-engine/pool-checks.ts",
    "test:ui": "bun run src/frontend/ui-checks.ts",
    "test:browser": "bun run src/frontend/browser-interaction-checks.ts",
    "test:workflow": "bun run src/frontend/workflow-checks.ts",
    "test:distribution": "bun run src/distribution/distribution-checks.ts",
    "test:cross-os": "bun run src/distribution/cross-os-checks.ts",
    "test:release-candidate": "bun run src/distribution/release-candidate-checks.ts",
    "start": "bun run src/cmd/cli.ts start",
    "status": "bun run src/cmd/cli.ts status",
    "stop": "bun run src/cmd/cli.ts stop"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "bun": "1.4.3",
    "hono": "^4.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.4.3",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "^4.3.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "^6.2.0"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
